{
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "aqi-api",
      "urls": ["/api/v1/aqi/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 5,
        "maxAge": "5m",
        "timeout": "3s"
      }
    },
    {
      "name": "plan-api",
      "urls": ["/api/v1/plan/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 3,
        "maxAge": "24h",
        "timeout": "5s"
      }
    }
  ]
}

