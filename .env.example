# ════════════════════════════════════════════════════════════════════════════
# CleanAir Companion — Environment Variables
# Copy this to .env and fill in real values before running.
# NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql+asyncpg://cleanair:change_me_strong_password@postgres:5432/cleanair
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
AQI_CACHE_TTL_SECONDS=300
PLAN_CACHE_TTL_SECONDS=86400

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
AQI_FETCH_INTERVAL_SECONDS=300

# ── AI (Google Gemini Primary) ───────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ── Secondary Providers (Optional) ───────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_TOP_K=8
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=change_me_at_least_64_char_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── External Air Quality APIs ─────────────────────────────────────────────────
# OpenAQ: https://docs.openaq.org/ (free tier available)
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3

# Open-Meteo: free, no key needed
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# CPCB / Sameer App API (optional India-specific)
CPCB_API_KEY=

# ── Notifications ─────────────────────────────────────────────────────────────
# WhatsApp Business API (Meta)
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_ID=

# Web Push VAPID keys — generate with: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=admin@your-domain.com

# ── Privacy ───────────────────────────────────────────────────────────────────
# Location rounded to this many decimal places (2 ≈ ±1 km)
LOCATION_PRECISION_DP=2

